{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1184px",
			"wideSize": "1184px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{
					"slug": "paper",
					"name": "Carta",
					"color": "#f4f2e9"
				},
				{
					"slug": "paper-light",
					"name": "Carta chiara",
					"color": "#fbfaf5"
				},
				{
					"slug": "ink",
					"name": "Inchiostro",
					"color": "#15121a"
				},
				{
					"slug": "ink-soft",
					"name": "Inchiostro tenue",
					"color": "#3b3640"
				},
				{
					"slug": "muted",
					"name": "Grigio",
					"color": "#6c6670"
				},
				{
					"slug": "pink",
					"name": "Rosa",
					"color": "#ff3f7a"
				},
				{
					"slug": "magenta",
					"name": "Magenta",
					"color": "#ff00c7"
				},
				{
					"slug": "research",
					"name": "Viola ricerca",
					"color": "#7b5cff"
				},
				{
					"slug": "white",
					"name": "Bianco",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"slug": "wero",
					"name": "WeRo (rosa → magenta)",
					"gradient": "linear-gradient(90deg, #ff3f7a 0%, #ff00c7 100%)"
				},
				{
					"slug": "night",
					"name": "Notte",
					"gradient": "linear-gradient(160deg, #241b2a 0%, #15121a 70%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "space-grotesk",
					"name": "Space Grotesk",
					"fontFamily": "\"Space Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/space-grotesk/space-grotesk-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/space-grotesk/space-grotesk-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"slug": "system",
					"name": "Sistema",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "tiny",
					"name": "Minimo (13)",
					"size": "13px"
				},
				{
					"slug": "small",
					"name": "Piccolo (14)",
					"size": "14px"
				},
				{
					"slug": "medium",
					"name": "Medio (16)",
					"size": "16px"
				},
				{
					"slug": "body",
					"name": "Testo (18)",
					"size": "18px"
				},
				{
					"slug": "lead",
					"name": "Introduzione",
					"size": "clamp(18px, 1.5vw, 21px)"
				},
				{
					"slug": "large",
					"name": "Grande",
					"size": "clamp(22px, 2.4vw, 30px)"
				},
				{
					"slug": "x-large",
					"name": "Molto grande",
					"size": "clamp(24px, 2.4vw, 32px)"
				},
				{
					"slug": "heading-story",
					"name": "Titolo racconto",
					"size": "clamp(28px, 3.2vw, 44px)"
				},
				{
					"slug": "hero",
					"name": "Titolo hero",
					"size": "clamp(32px, 4.4vw, 64px)"
				},
				{
					"slug": "section-small",
					"name": "Titolo sezione compatto",
					"size": "clamp(40px, 5vw, 72px)"
				},
				{
					"slug": "section",
					"name": "Titolo sezione",
					"size": "clamp(40px, 6vw, 88px)"
				},
				{
					"slug": "display",
					"name": "Titolo pagina",
					"size": "clamp(40px, 6.4vw, 96px)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"%",
				"em",
				"rem",
				"vw",
				"vh",
				"svh"
			],
			"spacingSizes": [
				{
					"slug": "xx-small",
					"name": "6",
					"size": "6px"
				},
				{
					"slug": "x-small",
					"name": "12",
					"size": "12px"
				},
				{
					"slug": "small",
					"name": "18",
					"size": "18px"
				},
				{
					"slug": "medium",
					"name": "Interno (24–44)",
					"size": "clamp(24px, 3.5vw, 44px)"
				},
				{
					"slug": "head",
					"name": "Titolo → contenuto (32–56)",
					"size": "clamp(32px, 4vw, 56px)"
				},
				{
					"slug": "block",
					"name": "Tra blocchi (48–80)",
					"size": "clamp(48px, 6vw, 80px)"
				},
				{
					"slug": "section",
					"name": "Sezione (56–88)",
					"size": "clamp(56px, 6vw, 88px)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"radiusSizes": [
				{
					"slug": "small",
					"name": "Piccolo (14)",
					"size": "14px"
				},
				{
					"slug": "medium",
					"name": "Medio (22)",
					"size": "22px"
				},
				{
					"slug": "large",
					"name": "Grande (28)",
					"size": "28px"
				},
				{
					"slug": "x-large",
					"name": "Fascia (40)",
					"size": "40px"
				},
				{
					"slug": "pill",
					"name": "Pillola",
					"size": "999px"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "glow",
					"name": "Alone magenta",
					"shadow": "0 10px 30px -10px rgba(255, 0, 199, 0.6)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 20px 60px -30px rgba(21, 18, 26, 0.35)"
				},
				{
					"slug": "nav",
					"name": "Menu",
					"shadow": "0 10px 40px -20px rgba(21, 18, 26, 0.35)"
				}
			]
		},
		"custom": {
			"ease": "cubic-bezier(.2, .8, .2, 1)",
			"gutter": "clamp(16px, 4vw, 48px)",
			"navHeight": "76px",
			"line": "rgba(21, 18, 26, 0.12)",
			"glass": "rgba(251, 250, 245, 0.9)",
			"wrap": "1280px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)",
				"top": "0px",
				"bottom": "0px"
			},
			"blockGap": "18px"
		},
		"elements": {
			"link": {
				"color": {
					"text": "inherit"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--magenta)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "500",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "0.98",
					"letterSpacing": "-0.045em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--section)",
					"lineHeight": "0.98",
					"letterSpacing": "-0.045em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--body)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				}
			},
			"button": {
				"color": {
					"gradient": "var(--wp--preset--gradient--wero)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "999px",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "15px",
						"bottom": "15px",
						"left": "26px",
						"right": "26px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.2"
				},
				"shadow": "var(--wp--preset--shadow--glow)"
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--ink-soft)"
				}
			},
			"textInput": {
				"color": {
					"background": "var(--wp--preset--color--white)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "14px",
					"width": "1.5px",
					"style": "solid",
					"color": "rgba(21, 18, 26, 0.12)"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "16px",
						"right": "16px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"select": {
				"color": {
					"background": "var(--wp--preset--color--white)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "14px",
					"width": "1.5px",
					"style": "solid",
					"color": "rgba(21, 18, 26, 0.12)"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "16px",
						"right": "16px"
					}
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "28px"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--magenta)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "20px"
					},
					"margin": {
						"top": "0.4em",
						"bottom": "0.4em"
					}
				},
				"typography": {
					"fontSize": "23px",
					"lineHeight": "1.4",
					"letterSpacing": "-0.015em"
				}
			},
			"core/separator": {
				"color": {
					"text": "rgba(21, 18, 26, 0.12)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "0.98",
					"letterSpacing": "-0.045em",
					"fontWeight": "500"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "clamp(20px, 1.9vw, 26px)",
					"lineHeight": "1.4",
					"letterSpacing": "-0.01em"
				}
			},
			"core/details": {
				"color": {
					"background": "var(--wp--preset--color--paper-light)"
				},
				"border": {
					"radius": "22px"
				},
				"spacing": {
					"padding": {
						"top": "4px",
						"bottom": "4px",
						"left": "22px",
						"right": "22px"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "progetto-articolo",
			"title": "Progetto – Articolo",
			"postTypes": [
				"progetto"
			]
		},
		{
			"name": "progetto-articolo-complesso",
			"title": "Progetto – Articolo complesso",
			"postTypes": [
				"progetto"
			]
		},
		{
			"name": "progetto-video",
			"title": "Progetto – Video",
			"postTypes": [
				"progetto"
			]
		},
		{
			"name": "progetto-podcast",
			"title": "Progetto – Podcast",
			"postTypes": [
				"progetto"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "cta-partner",
			"title": "Riquadro “Diventa partner”",
			"area": "uncategorized"
		},
		{
			"name": "progetto-testata",
			"title": "Progetto – Testata",
			"area": "uncategorized"
		},
		{
			"name": "progetto-chiusura",
			"title": "Progetto – Altri progetti e CTA",
			"area": "uncategorized"
		}
	]
}

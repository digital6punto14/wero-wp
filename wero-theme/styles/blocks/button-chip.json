{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"slug": "button-chip",
	"title": "Chip",
	"blockTypes": [
		"core/button"
	],
	"styles": {
		"color": {
			"gradient": "none",
			"background": "transparent",
			"text": "var(--wp--preset--color--ink)"
		},
		"shadow": "inset 0 0 0 1.5px var(--wp--preset--color--ink)",
		"spacing": {
			"padding": {
				"top": "9px",
				"bottom": "9px",
				"left": "18px",
				"right": "18px"
			}
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--small)"
		}
	}
}

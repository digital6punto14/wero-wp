{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wero/chapter",
  "version": "0.1.0",
  "category": "wero",
  "textdomain": "wero-core",
  "title": "Capitolo",
  "icon": "clock",
  "parent": [
    "wero/chapters"
  ],
  "description": "Un capitolo del video: tempo (mm:ss) e titolo.",
  "attributes": {
    "time": {
      "type": "string",
      "default": "00:00"
    },
    "seconds": {
      "type": "number",
      "default": 0
    },
    "label": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}